#############################################################################
# MetroLED Intelligence - example environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a placeholder; none of them are real secrets.
#############################################################################

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# "development" | "staging" | "production"
APP_ENV=development

# Public base URL users open (the React client). Used for links in the daily
# brief email and for OAuth redirect URIs. In development that is the Vite dev
# server, which proxies /api to the Express API.
APP_URL=http://localhost:3000

# Port the Express API listens on. In production the API also serves the
# built client, so APP_URL points at this server.
PORT=4000

# Optional: maximum PostgreSQL connections in the API's pool.
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Database (PostgreSQL 14+)
# ---------------------------------------------------------------------------

# Schema changes are plain SQL files in server/db/migrations, applied with
# `npm run db:migrate`.
DATABASE_URL="postgresql://metroled:change-me@localhost:5432/metroled"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-48-random-bytes-base64

# Separate key used to encrypt integration credentials at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------

# When DATABASE_URL is unreachable or the database holds no imported records,
# the application serves a clearly labelled demo dataset so the interface can
# be reviewed. Set to "false" in production to make missing data an explicit
# "data unavailable" state instead.
ALLOW_DEMO_DATA=true

# ---------------------------------------------------------------------------
# QuickBooks Online
# ---------------------------------------------------------------------------
# Create an app at https://developer.intuit.com. Redirect URI must be
# <APP_URL>/api/integrations/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" | "production"
QBO_ENVIRONMENT=sandbox
QBO_MINOR_VERSION=75

# ---------------------------------------------------------------------------
# Method CRM
# ---------------------------------------------------------------------------
# Method API v2 personal/organisation API key.
METHOD_API_KEY=
METHOD_API_BASE_URL=https://rest.method.me/api/v1

# ---------------------------------------------------------------------------
# Shopify (Eco LED Mart)
# ---------------------------------------------------------------------------
# Custom app with read_orders, read_products, read_customers scopes.
SHOPIFY_SHOP_DOMAIN=eco-led-mart.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
# Webhook signing secret from the custom app configuration.
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Monday.com - CONDITIONAL. Leave blank unless the client confirms inclusion.
# ---------------------------------------------------------------------------
MONDAY_API_TOKEN=
MONDAY_ENABLED=false

# ---------------------------------------------------------------------------
# AI assistant (Ask MetroLED)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Knowledge base (RAG) for Ask MetroLED. Anthropic has no embeddings endpoint,
# so retrieval uses Voyage AI. Without VOYAGE_API_KEY the assistant still
# answers figure questions via its data tools; it just cannot search the docs.
# After setting this (and running db:migrate), build the index with: npm run ai:index
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ---------------------------------------------------------------------------
# Email (Daily Executive Brief)
# ---------------------------------------------------------------------------
# Provider: "resend" | "ses" | "console"
# "console" writes the rendered email to the server log instead of sending.
EMAIL_PROVIDER=console
EMAIL_FROM="MetroLED Intelligence <intelligence@metroled.example>"
EMAIL_REPLY_TO=

RESEND_API_KEY=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Shared secret required by POST /api/cron/* so only the scheduler can trigger
# background work. Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Initial administrator (used by `npm run db:seed` only)
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL=ali@metroled.example
SEED_OWNER_NAME="Ali Jooma"
SEED_OWNER_PASSWORD=ChangeMeOnFirstLogin!
