// MetroLED Intelligence - unified analytics database.
//
// Design rules enforced throughout this schema:
//  1. Every record imported from an external system keeps its original
//     identifier (`sourceId`) plus the integration it came from, so any number
//     on a dashboard can be traced back to the record that produced it.
//  2. Imported rows are addressed by the composite key
//     (integrationId, sourceId). Sync uses `upsert` on that key, which makes
//     re-running a sync idempotent.
//  3. Money is Decimal(14, 2). Floating point is never used for currency.
//  4. Nothing is deleted by a sync. Rows that disappear upstream are marked
//     via status fields so historical reporting stays stable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RoleName {
  OWNER
  FINANCE
  ECOMMERCE
  SALES_REP
  OPERATIONS
}

enum IntegrationProvider {
  QUICKBOOKS
  METHOD_CRM
  SHOPIFY
  MONDAY
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  DEGRADED
  DISCONNECTED
  ERROR
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
  WEBHOOK
  BACKFILL
  RETRY
}

enum SyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum CustomerClassification {
  DIRECT
  DISTRIBUTOR
  UNCLASSIFIED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
  WRITTEN_OFF
}

enum QuoteStatus {
  OPEN
  WON
  LOST
  EXPIRED
  CANCELLED
}

enum ShopifyFinancialStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  UNKNOWN
}

enum ShopifyFulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RESTOCKED
  UNKNOWN
}

enum MetricApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BriefStatus {
  PENDING
  GENERATED
  SENT
  PARTIALLY_SENT
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SUPPRESSED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

enum MatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUALLY_MATCHED
  IGNORED
}

// ---------------------------------------------------------------------------
// Identity, roles and audit
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  timezone           String    @default("America/New_York")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // A sales rep user is linked to the rep record their data is scoped to.
  salesRepId String?

  roles           UserRole[]
  sessions        Session[]
  auditLogs       AuditLog[]
  conversations   AiConversation[]
  briefRecipients BriefRecipient[]
  salesRep        SalesRep?        @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  // Divisions a user is restricted to. No rows means "all divisions".
  divisionAccess  UserDivision[]

  @@index([isActive])
  @@index([salesRepId])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  label       String
  description String
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Explicit permission grants per role. The application reads this table so the
/// permissions matrix can be reviewed and adjusted without a code deploy.
model RolePermission {
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission])
}

model UserDivision {
  userId     String
  divisionId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([userId, divisionId])
  @@index([divisionId])
}

/// Server-side session records. The cookie carries a random token; only the
/// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Company configuration
// ---------------------------------------------------------------------------

model CompanySetting {
  id                String   @id @default("company")
  legalName         String   @default("MetroLED")
  displayName       String   @default("MetroLED")
  timezone          String   @default("America/New_York")
  currency          String   @default("CAD")
  fiscalYearStartMo Int      @default(1)
  briefSendHour     Int      @default(7)
  briefSendMinute   Int      @default(0)
  briefEnabled      Boolean  @default(false)
  staleDataHours    Int      @default(6)
  staleQuoteDays    Int      @default(21)
  largeQuoteAmount  Decimal  @default(10000) @db.Decimal(14, 2)
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

model Division {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers     Customer[]
  invoices      Invoice[]
  quotes        Quote[]
  shopifyOrders ShopifyOrder[]
  costEntries   DivisionCost[]
  mappingRules  DivisionMappingRule[]
  userAccess    UserDivision[]
  salesReps     SalesRep[]

  @@index([isActive, sortOrder])
}

/// Rules that assign a source record to a division. Evaluated in `priority`
/// order, lowest first. Changes are written to the audit log.
model DivisionMappingRule {
  id         String              @id @default(cuid())
  provider   IntegrationProvider
  field      String
  matchType  String
  matchValue String
  divisionId String
  priority   Int                 @default(100)
  isActive   Boolean             @default(true)
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  createdBy  String?

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([provider, isActive, priority])
  @@index([divisionId])
}

// ---------------------------------------------------------------------------
// Integrations and synchronisation
// ---------------------------------------------------------------------------

model Integration {
  id          String              @id @default(cuid())
  provider    IntegrationProvider @unique
  displayName String
  status      IntegrationStatus   @default(NOT_CONFIGURED)
  isEnabled   Boolean             @default(false)
  /// Non-secret connection metadata (realm id, shop domain, API version).
  config      Json?
  /// Encrypted credential envelope. Never returned by any API route.
  credentials Json?

  tokenExpiresAt      DateTime?
  lastSuccessAt       DateTime?
  lastAttemptAt       DateTime?
  lastErrorAt         DateTime?
  lastErrorMessage    String?
  consecutiveFailures Int       @default(0)
  syncIntervalMin     Int       @default(180)
  historyMonths       Int       @default(24)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  syncRuns      SyncRun[]
  checkpoints   SyncCheckpoint[]
  customerLinks CustomerSourceLink[]
  invoices      Invoice[]
  payments      Payment[]
  quotes        Quote[]
  shopifyOrders ShopifyOrder[]
  webhookEvents WebhookEvent[]
  unmatched     UnmatchedRecord[]

  @@index([isEnabled])
}

model SyncRun {
  id                String      @id @default(cuid())
  integrationId     String
  entity            String
  trigger           SyncTrigger
  status            SyncStatus  @default(QUEUED)
  startedAt         DateTime    @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  recordsRead       Int         @default(0)
  recordsCreated    Int         @default(0)
  recordsUpdated    Int         @default(0)
  recordsSkipped    Int         @default(0)
  recordsFailed     Int         @default(0)
  apiRequests       Int         @default(0)
  rangeStart        DateTime?
  rangeEnd          DateTime?
  errorSummary      String?
  triggeredByUserId String?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  errors      SyncError[]

  @@index([integrationId, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
}

model SyncError {
  id          String    @id @default(cuid())
  syncRunId   String
  entity      String
  sourceId    String?
  errorCode   String?
  message     String
  isRetryable Boolean   @default(true)
  payload     Json?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([resolvedAt])
  @@index([createdAt])
}

/// Resumable cursor per integration + entity, so an interrupted sync continues
/// where it stopped instead of re-reading the full history.
model SyncCheckpoint {
  id             String    @id @default(cuid())
  integrationId  String
  entity         String
  cursor         String?
  lastRecordAt   DateTime?
  backfillDoneTo DateTime?
  updatedAt      DateTime  @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, entity])
}

/// Raw inbound webhook deliveries. Stored before processing so a replay is
/// possible and a duplicate delivery is recognised by its provider event id.
model WebhookEvent {
  id            String    @id @default(cuid())
  integrationId String
  topic         String
  externalId    String
  payload       Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  processError  String?
  attempts      Int       @default(0)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, topic, externalId])
  @@index([processedAt])
}

/// PostgreSQL-backed job queue. Keeps the deployment footprint small - no
/// Redis is required at the Phase 1 data volume.
model Job {
  id             String    @id @default(cuid())
  queue          String
  name           String
  payload        Json?
  status         JobStatus @default(PENDING)
  runAt          DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastError      String?
  lockedBy       String?
  lockedAt       DateTime?
  /// Set for jobs that must run at most once, e.g. one daily brief per date.
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([status, runAt])
  @@index([queue, status])
}

// ---------------------------------------------------------------------------
// Customers and sales representatives
// ---------------------------------------------------------------------------

model Customer {
  id             String                 @id @default(cuid())
  name           String
  normalizedName String
  email          String?
  phone          String?
  city           String?
  region         String?
  country        String?
  classification CustomerClassification @default(UNCLASSIFIED)
  divisionId     String?
  isActive       Boolean                @default(true)
  firstSeenAt    DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  division      Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  sourceLinks   CustomerSourceLink[]
  invoices      Invoice[]
  quotes        Quote[]
  shopifyOrders ShopifyOrder[]

  @@index([normalizedName])
  @@index([divisionId])
  @@index([classification])
}

/// Maps one unified customer to its identity in each source system. This is the
/// cross-system matching table: one row per (integration, sourceId).
model CustomerSourceLink {
  id              String      @id @default(cuid())
  customerId      String
  integrationId   String
  sourceId        String
  sourceName      String
  sourceEmail     String?
  matchStatus     MatchStatus @default(AUTO_MATCHED)
  matchConfidence Int?
  matchedAt       DateTime    @default(now())
  matchedByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, sourceId])
  @@index([customerId])
  @@index([matchStatus])
}

/// Source records that could not be matched to a unified customer with enough
/// confidence. Surfaced on the Data Health page for manual review.
model UnmatchedRecord {
  id                  String      @id @default(cuid())
  integrationId       String
  entity              String
  sourceId            String
  sourceName          String
  reason              String
  payload             Json?
  suggestedCustomerId String?
  status              MatchStatus @default(UNMATCHED)
  resolvedAt          DateTime?
  resolvedByUserId    String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, entity, sourceId])
  @@index([status, createdAt])
}

model SalesRep {
  id             String   @id @default(cuid())
  name           String
  email          String?
  normalizedName String
  divisionId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  division    Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  users       User[]
  invoices    Invoice[]
  quotes      Quote[]
  sourceLinks SalesRepSourceLink[]

  @@index([normalizedName])
  @@index([isActive])
}

model SalesRepSourceLink {
  id            String   @id @default(cuid())
  salesRepId    String
  integrationId String
  sourceId      String
  sourceName    String
  createdAt     DateTime @default(now())

  salesRep SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  @@unique([integrationId, sourceId])
  @@index([salesRepId])
}

// ---------------------------------------------------------------------------
// Accounting: invoices and payments (QuickBooks Online)
// ---------------------------------------------------------------------------

model Invoice {
  id              String        @id @default(cuid())
  integrationId   String
  sourceId        String
  sourceDocNumber String
  customerId      String?
  divisionId      String?
  salesRepId      String?
  status          InvoiceStatus @default(OPEN)
  issuedOn        DateTime      @db.Date
  dueOn           DateTime?     @db.Date
  currency        String        @default("CAD")
  exchangeRate    Decimal       @default(1) @db.Decimal(14, 6)
  subtotal        Decimal       @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  total           Decimal       @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  balance         Decimal       @default(0) @db.Decimal(14, 2)
  /// Revenue recognised for reporting: subtotal excluding tax, in base currency.
  revenueAmount   Decimal       @db.Decimal(14, 2)
  costAmount      Decimal?      @db.Decimal(14, 2)
  memo            String?
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  syncedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  integration Integration          @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  division    Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  salesRep    SalesRep?            @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    PaymentApplication[]

  @@unique([integrationId, sourceId])
  @@index([issuedOn])
  @@index([dueOn])
  @@index([status, dueOn])
  @@index([divisionId, issuedOn])
  @@index([customerId, issuedOn])
  @@index([salesRepId, issuedOn])
}

model InvoiceLine {
  id           String   @id @default(cuid())
  invoiceId    String
  sourceLineId String?
  lineNumber   Int
  description  String?
  itemSourceId String?
  itemName     String?
  quantity     Decimal  @default(1) @db.Decimal(14, 4)
  unitPrice    Decimal  @default(0) @db.Decimal(14, 4)
  amount       Decimal  @db.Decimal(14, 2)
  costAmount   Decimal? @db.Decimal(14, 2)
  divisionId   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
  @@index([itemSourceId])
}

model Payment {
  id              String    @id @default(cuid())
  integrationId   String
  sourceId        String
  customerId      String?
  receivedOn      DateTime  @db.Date
  currency        String    @default("CAD")
  amount          Decimal   @db.Decimal(14, 2)
  method          String?
  reference       String?
  sourceUpdatedAt DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())

  integration  Integration          @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  applications PaymentApplication[]

  @@unique([integrationId, sourceId])
  @@index([receivedOn])
  @@index([customerId, receivedOn])
}

model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Sales pipeline (Method CRM)
// ---------------------------------------------------------------------------

model Quote {
  id              String      @id @default(cuid())
  integrationId   String
  sourceId        String
  sourceDocNumber String
  customerId      String?
  divisionId      String?
  salesRepId      String?
  status          QuoteStatus @default(OPEN)
  /// Raw stage label from Method CRM, preserved verbatim.
  stage           String
  /// Normalised stage used for grouping on the pipeline page.
  stageNormalized String
  currency        String      @default("CAD")
  amount          Decimal     @db.Decimal(14, 2)
  issuedOn        DateTime    @db.Date
  expiresOn       DateTime?   @db.Date
  closedOn        DateTime?   @db.Date
  lastActivityAt  DateTime?
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  syncedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  division    Division?   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  salesRep    SalesRep?   @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  lines       QuoteLine[]

  @@unique([integrationId, sourceId])
  @@index([status, issuedOn])
  @@index([divisionId, status])
  @@index([salesRepId, status])
  @@index([lastActivityAt])
  @@index([issuedOn])
}

model QuoteLine {
  id           String  @id @default(cuid())
  quoteId      String
  sourceLineId String?
  lineNumber   Int
  description  String?
  itemName     String?
  quantity     Decimal @default(1) @db.Decimal(14, 4)
  unitPrice    Decimal @default(0) @db.Decimal(14, 4)
  amount       Decimal @db.Decimal(14, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, lineNumber])
  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// E-commerce (Shopify - Eco LED Mart)
// ---------------------------------------------------------------------------

model ShopifyOrder {
  id                String                   @id @default(cuid())
  integrationId     String
  sourceId          String
  orderNumber       String
  customerId        String?
  divisionId        String?
  email             String?
  financialStatus   ShopifyFinancialStatus   @default(UNKNOWN)
  fulfillmentStatus ShopifyFulfillmentStatus @default(UNKNOWN)
  currency          String                   @default("CAD")
  subtotalPrice     Decimal                  @db.Decimal(14, 2)
  totalDiscounts    Decimal                  @default(0) @db.Decimal(14, 2)
  totalTax          Decimal                  @default(0) @db.Decimal(14, 2)
  totalShipping     Decimal                  @default(0) @db.Decimal(14, 2)
  totalRefunded     Decimal                  @default(0) @db.Decimal(14, 2)
  totalPrice        Decimal                  @db.Decimal(14, 2)
  /// Net merchandise sales used for reporting: subtotal (after discounts) minus
  /// refunds, excluding tax and shipping.
  netSalesAmount    Decimal                  @db.Decimal(14, 2)
  placedAt          DateTime
  cancelledAt       DateTime?
  closedAt          DateTime?
  sourceUpdatedAt   DateTime?
  syncedAt          DateTime                 @default(now())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  integration Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  division    Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  lines       ShopifyOrderLine[]

  @@unique([integrationId, sourceId])
  @@index([placedAt])
  @@index([financialStatus, placedAt])
  @@index([fulfillmentStatus])
  @@index([divisionId, placedAt])
}

model ShopifyOrderLine {
  id              String  @id @default(cuid())
  orderId         String
  sourceLineId    String
  lineNumber      Int
  productSourceId String?
  variantSourceId String?
  sku             String?
  title           String
  quantity        Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(14, 4)
  discount        Decimal @default(0) @db.Decimal(14, 2)
  amount          Decimal @db.Decimal(14, 2)

  order ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sourceLineId])
  @@index([productSourceId])
  @@index([sku])
}

// ---------------------------------------------------------------------------
// Cost of goods sold / gross margin inputs
// ---------------------------------------------------------------------------

/// Direct-cost basis per division and month, mapped from approved QuickBooks
/// COGS accounts. Operating expenses are deliberately excluded.
model DivisionCost {
  id             String    @id @default(cuid())
  divisionId     String
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  cogsAmount     Decimal   @db.Decimal(14, 2)
  currency       String    @default("CAD")
  /// QuickBooks account references that contributed to this figure.
  sourceAccounts Json?
  basis          String    @default("QBO_COGS_ACCOUNTS")
  isApproved     Boolean   @default(false)
  approvedBy     String?
  approvedAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([divisionId, periodStart])
  @@index([periodStart])
}

/// Which QuickBooks accounts count as direct cost. Editing this is audited.
model CogsAccountMapping {
  id              String   @id @default(cuid())
  sourceAccountId String   @unique
  accountName     String
  accountType     String?
  includeInCogs   Boolean  @default(false)
  divisionId      String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([includeInCogs])
}

// ---------------------------------------------------------------------------
// Metric definitions and reconciliation
// ---------------------------------------------------------------------------

model MetricDefinition {
  id               String               @id @default(cuid())
  key              String               @unique
  name             String
  shortDescription String
  formula          String
  sourceSystems    String[]
  dateBasis        String
  includedRecords  String
  excludedRecords  String
  currencyHandling String
  divisionMapping  String
  approvalStatus   MetricApprovalStatus @default(DRAFT)
  approvedBy       String?
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  reconciliations Reconciliation[]
}

/// Records a comparison of a platform figure against the source system for a
/// closed period. A metric is only reported as verified when the latest
/// reconciliation for the period passed.
model Reconciliation {
  id                 String   @id @default(cuid())
  metricDefinitionId String
  periodStart        DateTime @db.Date
  periodEnd          DateTime @db.Date
  divisionId         String?
  platformValue      Decimal  @db.Decimal(14, 2)
  sourceValue        Decimal  @db.Decimal(14, 2)
  variance           Decimal  @db.Decimal(14, 2)
  variancePct        Decimal  @db.Decimal(9, 4)
  tolerancePct       Decimal  @default(0.5) @db.Decimal(9, 4)
  passed             Boolean
  performedBy        String?
  note               String?
  createdAt          DateTime @default(now())

  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Cascade)

  @@index([metricDefinitionId, periodStart])
  @@index([periodStart])
}

// ---------------------------------------------------------------------------
// Daily executive brief
// ---------------------------------------------------------------------------

model DailyBrief {
  id           String      @id @default(cuid())
  /// The business date the brief reports on (yesterday, in company timezone).
  briefDate    DateTime    @unique @db.Date
  status       BriefStatus @default(PENDING)
  generatedAt  DateTime?
  /// Structured snapshot of every figure in the brief, so the page and the
  /// email always show the same numbers.
  payload      Json?
  htmlBody     String?
  textBody     String?
  subject      String?
  dataWarnings String[]
  generationMs Int?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  deliveries BriefDelivery[]

  @@index([briefDate])
}

model BriefDelivery {
  id                String         @id @default(cuid())
  dailyBriefId      String
  recipient         String
  status            DeliveryStatus @default(QUEUED)
  attempts          Int            @default(0)
  providerMessageId String?
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  dailyBrief DailyBrief @relation(fields: [dailyBriefId], references: [id], onDelete: Cascade)

  @@unique([dailyBriefId, recipient])
  @@index([status])
}

model BriefRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  userId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Ask MetroLED - AI assistant audit trail
// ---------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  /// Which approved query tools ran, with their validated parameters and the
  /// row counts returned. This is the audit record for every AI answer.
  toolCalls      Json?
  sources        Json?
  dataMode       String?
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  model          String?
  refusalReason  String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
